+def test_authenticated_request_refreshes_a_rejected_token_once(monkeypatch):
+    tokens = iter(["stale-token", "fresh-token"])
+    client = _AuthRetryClient([401, 200])
+    slskd._slskd_token_cache[("http://slskd.test", "user")] = (
+        "stale-token", float("inf")
+    )
+
+    monkeypatch.setattr(slskd, "get_slskd_token", lambda: next(tokens))
+    monkeypatch.setattr(
+        slskd,
+        "get_setting",
+        lambda name: {
+            "slskd_url": "http://slskd.test",
+            "slskd_user": "user",
+        }[name],
+    )
+
+    response = slskd._slskd_request(
+        client,
+        "post",
+        "http://slskd.test/api/v0/searches",
+        json={"searchText": "Fleetwood Mac - Dreams"},
+    )
+
+    assert response.status_code == 200
+    assert client.tokens == ["Bearer stale-token", "Bearer fresh-token"]
+    assert ("http://slskd.test", "user") not in slskd._slskd_token_cache
+
+
