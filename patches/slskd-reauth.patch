+def _slskd_request(client, method: str, url: str, **kwargs):
+    """Make an authenticated request, retrying once after a rejected token."""
+    token = get_slskd_token()
+    if not token:
+        raise RuntimeError("slskd authentication failed")
+
+    request = getattr(client, method)
+    response = request(
+        url,
+        headers={"Authorization": f"Bearer {token}"},
+        **kwargs,
+    )
+    if response.status_code != 401:
+        return response
+
+    slskd_url = get_setting("slskd_url")
+    slskd_user = get_setting("slskd_user")
+    _slskd_token_cache.pop((slskd_url, slskd_user), None)
+
+    token = get_slskd_token()
+    if not token:
+        return response
+
+    return request(
+        url,
+        headers={"Authorization": f"Bearer {token}"},
+        **kwargs,
+    )
+
