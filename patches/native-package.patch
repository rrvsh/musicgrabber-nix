diff --git a/selenium_runtime.py b/selenium_runtime.py
new file mode 100644
index 0000000..25a858e
--- /dev/null
+++ b/selenium_runtime.py
@@ -0,0 +1,141 @@
+"""Native-package SeleniumBase browser and driver configuration."""
+
+import os
+import platform
+import shutil
+import stat
+import subprocess
+import tempfile
+from pathlib import Path
+
+
+def _version_output(executable: Path) -> str:
+    result = subprocess.run(
+        [str(executable), "--version"],
+        check=True,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    return result.stdout.strip()
+
+
+def _driver_is_usable(driver: Path, expected_version: str) -> bool:
+    if not driver.is_file():
+        return False
+
+    try:
+        from seleniumbase.undetected.patcher import Patcher
+
+        return (
+            Patcher(executable_path=str(driver)).is_binary_patched()
+            and expected_version in _version_output(driver)
+        )
+    except Exception:
+        return False
+
+
+def _prepare_driver(source: Path, directory: Path, expected_version: str) -> Path:
+    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
+    directory.chmod(0o700)
+    driver = directory / "uc_driver"
+    if _driver_is_usable(driver, expected_version):
+        return directory
+
+    descriptor, temporary_name = tempfile.mkstemp(prefix=".uc_driver.", dir=directory)
+    os.close(descriptor)
+    temporary = Path(temporary_name)
+
+    try:
+        shutil.copyfile(source, temporary)
+        temporary.chmod(stat.S_IRUSR | stat.S_IWUSR | stat.S_IXUSR)
+
+        from seleniumbase.undetected.patcher import Patcher
+
+        patcher = Patcher(executable_path=str(temporary))
+        patcher.patch()
+        if not patcher.is_binary_patched():
+            raise RuntimeError("SeleniumBase did not patch ChromeDriver")
+
+        if platform.system() == "Darwin":
+            subprocess.run(
+                ["/usr/bin/codesign", "--force", "--sign", "-", str(temporary)],
+                check=True,
+                capture_output=True,
+                text=True,
+            )
+
+        if expected_version not in _version_output(temporary):
+            raise RuntimeError(
+                f"Packaged ChromeDriver does not report {expected_version}"
+            )
+
+        os.replace(temporary, driver)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+    return directory
+
+
+def browser_options() -> dict:
+    options = {
+        "uc": True,
+        "test": True,
+        "xvfb": True,
+        "locale": "en",
+        "chromium_arg": "no-sandbox,disable-dev-shm-usage",
+    }
+
+    browser_value = os.environ.get("MUSICGRABBER_SELENIUM_BROWSER", "").strip()
+    driver_source_value = os.environ.get(
+        "MUSICGRABBER_SELENIUM_DRIVER_SOURCE", ""
+    ).strip()
+    driver_directory_value = os.environ.get(
+        "MUSICGRABBER_SELENIUM_DRIVER_DIR", ""
+    ).strip()
+    expected_version = os.environ.get(
+        "MUSICGRABBER_SELENIUM_VERSION", ""
+    ).strip()
+
+    packaged_values = (
+        browser_value,
+        driver_source_value,
+        driver_directory_value,
+        expected_version,
+    )
+    if any(packaged_values) and not all(packaged_values):
+        raise RuntimeError("Packaged Selenium configuration is incomplete")
+
+    if all(packaged_values):
+        browser = Path(browser_value)
+        driver_source = Path(driver_source_value)
+        driver_directory = Path(driver_directory_value)
+
+        if not browser.is_file():
+            raise RuntimeError(f"Packaged Selenium browser does not exist: {browser}")
+        if not driver_source.is_file():
+            raise RuntimeError(f"Packaged ChromeDriver does not exist: {driver_source}")
+        if expected_version not in _version_output(browser):
+            raise RuntimeError(f"Packaged browser does not report {expected_version}")
+
+        from seleniumbase.core.browser_launcher import override_driver_dir
+
+        override_driver_dir(
+            str(_prepare_driver(driver_source, driver_directory, expected_version))
+        )
+        work_directory = driver_directory.parent / "work"
+        work_directory.mkdir(mode=0o700, parents=True, exist_ok=True)
+        work_directory.chmod(0o700)
+        os.chdir(work_directory)
+        options["use_chromium"] = True
+        options["binary_location"] = str(browser)
+        options["driver_version"] = "keep"
+        return options
+
+    chrome = shutil.which("google-chrome")
+    chromium = shutil.which("chromium")
+    if not chrome and chromium:
+        options["use_chromium"] = True
+        options["binary_location"] = chromium
+
+    return options
